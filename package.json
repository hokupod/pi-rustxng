{
  "name": "pi-rustxng",
  "version": "0.2.0",
  "description": "RustXNG web search and page reading through native MCP in Pi and oh-my-pi",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package",
    "rustxng",
    "mcp",
    "search",
    "omp-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hokupod/pi-rustxng.git"
  },
  "files": [
    "src",
    "scripts/install-rustxng.mjs",
    "config",
    "docs",
    "LICENSE",
    "README.md",
    "README.ja.md",
    ".mcp.json",
    "scripts/launch-mcp.mjs"
  ],
  "scripts": {
    "test": "node --test",
    "install:rustxng": "node scripts/install-rustxng.mjs",
    "safe": "node scripts/safe-chain.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check": "node scripts/check.mjs",
    "secrets:check": "node scripts/secrets-check.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "pi": {
    "extensions": [
      "./src/extension.mjs"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.4"
    }
  },
  "omp": {
    "extensions": [
      "./src/omp-extension.mjs"
    ]
  }
}
